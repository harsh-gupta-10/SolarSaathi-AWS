# Phase 0 integrations are optional. Never put server values in NEXT_PUBLIC_* fields.
# Copy only the Web section into apps/web/.env.local.

# Web
NEXT_PUBLIC_API_BASE_URL=
# Browser key restricted to app origins and Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REGION=ap-south-1
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=
NEXT_PUBLIC_COGNITO_GOOGLE_ENABLED=false

# Server / Lambda (configure in SAM/Lambda, not in the browser)
ENVIRONMENT=dev
LOG_LEVEL=info
API_ALLOWED_ORIGIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
AWS_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
GOOGLE_GEOCODING_API_KEY=
GOOGLE_SOLAR_API_KEY=
BEDROCK_MODEL_ID=
CORE_TABLE_NAME=
USERS_TABLE_NAME=
ORGS_TABLE_NAME=
CUSTOMERS_TABLE_NAME=
PROPERTIES_TABLE_NAME=
ANALYSES_TABLE_NAME=
LEADS_TABLE_NAME=
SOLAR_CACHE_TABLE_NAME=
